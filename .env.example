# JALDRISHTI Production Environment Configuration Example

# Frontend Port Configuration
VITE_PORT=5173
VITE_PREVIEW_PORT=4173

# Optional External API Integrations (System automatically uses keyless OpenStreetMap tiles & simulated models if keys are omitted)
# VITE_IMD_WEATHER_API_KEY=your_imd_api_key_here
# VITE_CWC_FLOOD_API_KEY=your_cwc_api_key_here
# VITE_NASA_GPM_API_KEY=your_nasa_gpm_api_key_here
# VITE_ISRO_MOSDAC_API_KEY=your_isro_mosdac_api_key_here

# Backend Service URL (Defaults to local express proxy or server)
VITE_API_BASE_URL=http://localhost:3001
